[Unit]
Description=TinyPiRelay web control service
StartLimitIntervalSec=0

[Service]
Type=simple
User=tinypirelay-web
Group=tinypirelay-control
SupplementaryGroups=tinypirelay-web
WorkingDirectory=/opt/tinypirelay/current
Environment=PYTHONPATH=/opt/tinypirelay/current/src
ExecStart=/usr/bin/python3 -P -B -m tinypirelay.web_service serve --credentials /etc/tinypirelay/web/credential.json --setup-pending /etc/tinypirelay/web/setup-pending --control-socket /run/tinypirelay/control.sock --bind 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=2
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/etc/tinypirelay/web
ProtectHome=true
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=tcp:8080
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
TasksMax=64
LimitNOFILE=256
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
